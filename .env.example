ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Primary provider: groq | ollama | gemini
PRIMARY_PROVIDER=groq
# Optional provider used only after primary exhausts its retries
FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model names change; check the provider console or `ollama list`.
MODEL_FAST=llama-3.1-8b-instant
MODEL_STRONG=llama-3.3-70b-versatile
LLM_SUPPORTS_JSON_MODE=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

MAX_REQUEST_CHARS=4000
MAX_CONCURRENCY=4
MAX_REFLECTION_LOOPS=2
REFLECTION_LLM_MODE=auto
RUN_TIMEOUT_S=120

DATA_DIR=./data
DEFAULT_AUTHOR=DocPilot
# Comma-separated X-API-Key values. Empty disables authentication.
API_KEYS=
CACHE_ENABLED=true
