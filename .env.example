ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Primary provider: groq | ollama | gemini | openrouter
PRIMARY_PROVIDER=groq
# Optional provider used only after primary exhausts its retries
FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model names change; check the provider console or `ollama list`.
# Groq free-tier examples:
MODEL_FAST=openai/gpt-oss-20b
MODEL_STRONG=openai/gpt-oss-120b
# Per-stage routing: fast | strong
ANALYSIS_TIER=fast
PLANNING_TIER=fast
WRITING_TIER=strong
REFLECTION_TIER=strong
COMPOSITION_TIER=fast
CORRECTION_TIER=fast
# Gemini free-tier example:
# PRIMARY_PROVIDER=gemini
# GEMINI_API_KEY=...
# MODEL_FAST=gemini-3.5-flash-lite
# MODEL_STRONG=gemini-3.5-flash-lite
# OpenRouter free-tier example (availability varies):
# PRIMARY_PROVIDER=openrouter
# OPENROUTER_API_KEY=...
# MODEL_FAST=dots-studio/dots-3-note-preview:free
# MODEL_STRONG=dots-studio/dots-3-note-preview:free
# LLM_REASONING_EFFORT=none
LLM_SUPPORTS_JSON_MODE=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Lower this when prompt plus output would exceed a provider's per-minute limit.
LLM_MAX_OUTPUT_TOKENS=4096
# Optional: low | medium | high. Use "low" for Groq gpt-oss free-tier limits.
# Leave empty for providers that do not support reasoning-effort parameters.
LLM_REASONING_EFFORT=
# Minimum seconds between provider calls. 0 disables pacing; use ~4.2 to stay
# under Gemini's 15 requests/minute free-tier limit and avoid burst 429s.
LLM_MIN_INTERVAL_S=0

MAX_REQUEST_CHARS=4000
MAX_CONCURRENCY=4
MAX_REFLECTION_LOOPS=2
REFLECTION_LLM_MODE=auto
# Reflection is best-effort; the current draft is rendered if this budget expires.
REFLECTION_TIMEOUT_S=180
RUN_TIMEOUT_S=120

DATA_DIR=./data
DEFAULT_AUTHOR=Productivity
# Comma-separated X-API-Key values. Empty disables authentication.
API_KEYS=
CACHE_ENABLED=true
CACHE_TTL_S=3600
CACHE_MAX_ENTRIES=256
# Completed runs are replayed instantly on exact-repeat demo requests.
HOT_CACHE_ENABLED=true
HOT_CACHE_TTL_S=86400
HOT_CACHE_MAX_ENTRIES=8
